# Neon Data API의 HTTPS 데이터베이스 URL입니다. postgresql:// 연결 문자열이 아닙니다.
VITE_NEON_DATABASE_URL=https://YOUR_ENDPOINT.REGION.aws.neon.tech/YOUR_DATABASE

# Neon Console의 Auth > Configuration에서 복사합니다.
VITE_NEON_AUTH_URL=https://YOUR_ENDPOINT.neonauth.REGION.aws.neon.tech/YOUR_DATABASE/auth

# 자동 파생된 주소가 동작하지 않을 때만 Data API 화면의 주소를 입력합니다.
# VITE_NEON_DATA_API_URL=https://YOUR_ENDPOINT.apirest.REGION.aws.neon.tech/YOUR_DATABASE/rest/v1